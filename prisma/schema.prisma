generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int           @id @default(autoincrement())
  email          String        @unique
  password       String?
  name           String?
  username       String?       @unique
  emailVerified  DateTime?
  image          String?
  role           Role?
  profile        UserProfile?
  settings       UserSettings?
  posts          Post[]
  jobs           Job[]
  proposals      Proposal[]    @relation("FreelancerProposals")
  freelancerJobs ActiveJob[]   @relation("FreelancerJobs")
  clientJobs     ActiveJob[]   @relation("ClientJobs")
  jobMessages    JobMessage[]  @relation("JobMessageSender")
  conversations  ConversationParticipant[]
  messages       Message[]     @relation("MessageSender")
  presence       UserPresence?
  notifications  Notification[]
  savedJobs      SavedJob[]
  savedSearches  SavedSearch[]
  accounts       Account[]
  sessions       Session[]
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String?
  published Boolean @default(false)
  authorId  Int
  author    User    @relation(fields: [authorId], references: [id])
}

model Job {
  id             String     @id @default(cuid())
  title          String
  description    String
  company        String
  budget         Float?
  salary         String?
  skills         String[]
  type           String
  experience     String
  location       String     @default("Remote")
  remote         Boolean    @default(true)
  verifiedClient Boolean    @default(false)
  source         String     @default("internal")
  externalId     String?
  externalUrl    String?
  postedAt       DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  clientId       Int?
  client         User?      @relation(fields: [clientId], references: [id])
  proposals      Proposal[]
  savedJobs      SavedJob[]

  @@index([source, externalId])
  @@index([postedAt])
  @@index([clientId])
}

model Proposal {
  id                   String         @id @default(cuid())
  coverLetter          String
  budget               Float?
  timeline             String?
  portfolioLinks       String[]       @default([])
  resumeUrl            String?
  status               ProposalStatus @default(DRAFT)
  externalJobId        String?
  externalJobUrl       String?
  clientMessage        String?
  meetingUrl           String?
  submittedAt          DateTime?
  viewedAt             DateTime?
  respondedAt          DateTime?
  interviewAt          DateTime?
  acceptedAt           DateTime?
  withdrawnAt          DateTime?
  lastClientActivityAt DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  freelancerId Int
  jobId        String?
  activeJob    ActiveJob?

  freelancer  User                 @relation("FreelancerProposals", fields: [freelancerId], references: [id])
  job         Job?                 @relation(fields: [jobId], references: [id])
  attachments ProposalAttachment[]

  @@index([freelancerId, status])
  @@index([jobId])
  @@index([updatedAt])
}

model ActiveJob {
  id            String        @id @default(cuid())
  title         String
  description   String
  budget        Float?
  progress      Int           @default(0)
  status        JobStatus     @default(IN_PROGRESS)
  priority      String?
  deadline      DateTime?
  paymentStatus PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposalId String?   @unique
  proposal   Proposal? @relation(fields: [proposalId], references: [id])

  freelancerId Int
  freelancer   User @relation("FreelancerJobs", fields: [freelancerId], references: [id])

  clientId Int
  client   User @relation("ClientJobs", fields: [clientId], references: [id])

  milestones   Milestone[]
  messages     JobMessage[]
  deliverables Deliverable[]

  @@index([freelancerId, status])
  @@index([clientId, status])
  @@index([deadline])
  @@index([updatedAt])
}

model Milestone {
  id            String        @id @default(cuid())
  title         String
  description   String?
  amount        Float?
  dueDate       DateTime?
  completed     Boolean       @default(false)
  completedAt   DateTime?
  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  jobId String
  job   ActiveJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, completed])
  @@index([dueDate])
}

model JobMessage {
  id        String    @id @default(cuid())
  message   String
  fileUrl   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  senderId Int
  jobId    String

  sender User      @relation("JobMessageSender", fields: [senderId], references: [id])
  job    ActiveJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([senderId])
}

model Deliverable {
  id             String            @id @default(cuid())
  title          String
  fileUrl        String
  fileName       String?
  fileType       String?
  version        Int               @default(1)
  revisionNotes  String?
  approvalStatus DeliverableStatus @default(SUBMITTED)
  uploadedAt     DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  jobId String
  job   ActiveJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, uploadedAt])
}

model ProposalAttachment {
  id         String @id @default(cuid())
  fileName   String
  fileUrl    String
  proposalId String

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  VIEWED
  INTERVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum JobStatus {
  IN_PROGRESS
  REVIEW
  COMPLETED
  BLOCKED
  AT_RISK
}

enum PaymentStatus {
  PENDING
  FUNDED
  RELEASED
  DISPUTED
}

enum DeliverableStatus {
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
}

model SavedJob {
  id             String   @id @default(cuid())
  userId         Int
  jobId          String?
  externalJobId  String?
  externalJobUrl String?
  title          String
  company        String
  source         String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  job  Job? @relation(fields: [jobId], references: [id])

  @@unique([userId, jobId])
  @@unique([userId, externalJobId])
  @@index([userId, createdAt])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    Int
  name      String
  query     String
  filters   Json
  alerts    Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Conversation {
  id        String   @id @default(cuid())
  title     String?
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  userId         Int
  conversationId String
  pinned         Boolean   @default(false)
  archived       Boolean   @default(false)
  lastReadAt     DateTime?
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([userId, pinned, archived])
  @@index([conversationId])
}

model Message {
  id             String          @id @default(cuid())
  content        String?
  imageUrl       String?
  fileUrl        String?
  fileName       String?
  fileType       String?
  fileSize       Int?
  attachmentKind AttachmentKind?
  seen           Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  senderId       Int
  sender         User            @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model UserPresence {
  id          String   @id @default(cuid())
  userId      Int      @unique
  online      Boolean  @default(false)
  lastActiveAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([online, lastActiveAt])
}

model Notification {
  id             String           @id @default(cuid())
  type           NotificationType @default(MESSAGE)
  title          String
  body           String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  userId         Int
  conversationId String?
  messageId      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([conversationId])
}

enum AttachmentKind {
  IMAGE
  PDF
  ZIP
  DOC
  FILE
}

enum NotificationType {
  MESSAGE
  MENTION
  FILE
}

model UserProfile {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  phone              String?
  location           String?
  timezone           String?
  languages          String?
  title              String?
  bio                String?
  experienceLevel    String?
  hourlyRate         Float?
  availability       String?
  portfolioWebsite   String?
  github             String?
  linkedin           String?
  preferredJobType   String?
  budgetRange        String?
  weeklyAvailability String?
  remoteOnly         Boolean  @default(true)
  openToContract     Boolean  @default(true)
  skills             String[] @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  displayName        String?
  workspaceName      String?
  emailNotifications Boolean  @default(true)
  inAppNotifications Boolean  @default(true)
  marketingDigest    Boolean  @default(false)
  proposalAlerts     Boolean  @default(true)
  messageAlerts      Boolean  @default(true)
  paymentAlerts      Boolean  @default(true)
  twoFactor          Boolean  @default(false)
  loginAlerts        Boolean  @default(true)
  publicProfile      Boolean  @default(true)
  dataSharing        Boolean  @default(false)
  autoSaveDrafts     Boolean  @default(true)
  weeklySummary      Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CLIENT
  FREELANCER
}

model Account {
  id                 String  @id @default(cuid())
  userId             Int
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
