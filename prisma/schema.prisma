generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int           @id @default(autoincrement())
  email          String        @unique
  name           String?
  posts          Post[]
  jobs           Job[]
  proposals      Proposal[]    @relation("FreelancerProposals")
  freelancerJobs ActiveJob[]   @relation("FreelancerJobs")
  clientJobs     ActiveJob[]   @relation("ClientJobs")
  jobMessages    JobMessage[]  @relation("JobMessageSender")
  savedJobs      SavedJob[]
  savedSearches  SavedSearch[]
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String?
  published Boolean @default(false)
  authorId  Int
  author    User    @relation(fields: [authorId], references: [id])
}

model Job {
  id             String     @id @default(cuid())
  title          String
  description    String
  company        String
  budget         Float?
  salary         String?
  skills         String[]
  type           String
  experience     String
  location       String     @default("Remote")
  remote         Boolean    @default(true)
  verifiedClient Boolean    @default(false)
  source         String     @default("internal")
  externalId     String?
  externalUrl    String?
  postedAt       DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  clientId       Int?
  client         User?      @relation(fields: [clientId], references: [id])
  proposals      Proposal[]
  savedJobs      SavedJob[]

  @@index([source, externalId])
  @@index([postedAt])
  @@index([clientId])
}

model Proposal {
  id                   String         @id @default(cuid())
  coverLetter          String
  budget               Float?
  timeline             String?
  portfolioLinks       String[]       @default([])
  resumeUrl            String?
  status               ProposalStatus @default(DRAFT)
  externalJobId        String?
  externalJobUrl       String?
  clientMessage        String?
  meetingUrl           String?
  submittedAt          DateTime?
  viewedAt             DateTime?
  respondedAt          DateTime?
  interviewAt          DateTime?
  acceptedAt           DateTime?
  withdrawnAt          DateTime?
  lastClientActivityAt DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  freelancerId Int
  jobId        String?
  activeJob    ActiveJob?

  freelancer  User                 @relation("FreelancerProposals", fields: [freelancerId], references: [id])
  job         Job?                 @relation(fields: [jobId], references: [id])
  attachments ProposalAttachment[]

  @@index([freelancerId, status])
  @@index([jobId])
  @@index([updatedAt])
}

model ActiveJob {
  id            String        @id @default(cuid())
  title         String
  description   String
  budget        Float?
  progress      Int           @default(0)
  status        JobStatus     @default(IN_PROGRESS)
  priority      String?
  deadline      DateTime?
  paymentStatus PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposalId String?   @unique
  proposal   Proposal? @relation(fields: [proposalId], references: [id])

  freelancerId Int
  freelancer   User @relation("FreelancerJobs", fields: [freelancerId], references: [id])

  clientId Int
  client   User @relation("ClientJobs", fields: [clientId], references: [id])

  milestones   Milestone[]
  messages     JobMessage[]
  deliverables Deliverable[]

  @@index([freelancerId, status])
  @@index([clientId, status])
  @@index([deadline])
  @@index([updatedAt])
}

model Milestone {
  id            String        @id @default(cuid())
  title         String
  description   String?
  amount        Float?
  dueDate       DateTime?
  completed     Boolean       @default(false)
  completedAt   DateTime?
  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  jobId String
  job   ActiveJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, completed])
  @@index([dueDate])
}

model JobMessage {
  id        String    @id @default(cuid())
  message   String
  fileUrl   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  senderId Int
  jobId    String

  sender User      @relation("JobMessageSender", fields: [senderId], references: [id])
  job    ActiveJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([senderId])
}

model Deliverable {
  id             String            @id @default(cuid())
  title          String
  fileUrl        String
  fileName       String?
  fileType       String?
  version        Int               @default(1)
  revisionNotes  String?
  approvalStatus DeliverableStatus @default(SUBMITTED)
  uploadedAt     DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  jobId String
  job   ActiveJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, uploadedAt])
}

model ProposalAttachment {
  id         String @id @default(cuid())
  fileName   String
  fileUrl    String
  proposalId String

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  VIEWED
  INTERVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum JobStatus {
  IN_PROGRESS
  REVIEW
  COMPLETED
  BLOCKED
  AT_RISK
}

enum PaymentStatus {
  PENDING
  FUNDED
  RELEASED
  DISPUTED
}

enum DeliverableStatus {
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
}

model SavedJob {
  id             String   @id @default(cuid())
  userId         Int
  jobId          String?
  externalJobId  String?
  externalJobUrl String?
  title          String
  company        String
  source         String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  job  Job? @relation(fields: [jobId], references: [id])

  @@unique([userId, jobId])
  @@unique([userId, externalJobId])
  @@index([userId, createdAt])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    Int
  name      String
  query     String
  filters   Json
  alerts    Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}
